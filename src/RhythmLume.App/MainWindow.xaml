<Window x:Class="RhythmLume.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RhythmLume.App"
        Title="RhythmLume"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0D1425"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentGradient}">
                        <TextBlock Text="R" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="RhythmLume" FontSize="21" FontWeight="Bold"/>
                        <TextBlock Text="Music becomes motion" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </StackPanel>

                <WrapPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#101C2C" CornerRadius="12" Padding="12,6" Margin="4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding BridgeStatus}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#17142C" CornerRadius="12" Padding="12,6" Margin="4">
                        <TextBlock Text="{Binding BridgeMode}" FontSize="12"/>
                    </Border>
                    <Border Background="#151A29" CornerRadius="12" Padding="12,6" Margin="4">
                        <TextBlock FontSize="12">
                            <Run Text="{Binding SelectedLightCount}"/><Run Text=" lights"/>
                        </TextBlock>
                    </Border>
                    <Border Background="#151A29" CornerRadius="12" Padding="12,6" Margin="4">
                        <TextBlock Text="{Binding CurrentEffect}" FontSize="12"/>
                    </Border>
                </WrapPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding CurrentInput}" FontSize="12" HorizontalAlignment="Right"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                        <ProgressBar Value="{Binding InputLevel}" Maximum="100" Width="120"/>
                        <TextBlock Text="{Binding AudioStatus}" Foreground="{StaticResource MutedBrush}"
                                   FontSize="11" Margin="9,-2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="20,12,20,0">
            <TabItem Header="Setup">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,16,2,12">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="28">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Turn every kick into movement."
                                               FontSize="32" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock Text="Capture Windows playback or an AUX input, analyze the music in real time, and drive your room with smooth, adaptive Hue effects."
                                               Foreground="{StaticResource MutedBrush}" FontSize="15"
                                               TextWrapping="Wrap" Margin="0,12,40,18"/>
                                    <WrapPanel>
                                        <Button Content="1  Choose audio" Command="{Binding RefreshDevicesCommand}"/>
                                        <Button Content="2  Find bridge" Command="{Binding DiscoverBridgesCommand}"/>
                                        <Button Content="3  Select lights" Command="{Binding ConnectBridgeCommand}"/>
                                    </WrapPanel>
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="18" Background="#0B1224" Padding="24">
                                    <StackPanel>
                                        <TextBlock Text="Signal path" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="WASAPI capture" FontWeight="SemiBold"/>
                                        <ProgressBar Value="100" Margin="0,8,0,12"/>
                                        <TextBlock Text="2048-point FFT · adaptive kick detection"
                                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                        <ProgressBar Value="82" Margin="0,8,0,12"/>
                                        <TextBlock Text="Effect smoothing · coalesced Hue output"
                                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Audio input" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="System playback uses WASAPI loopback. Choose a microphone or line-in endpoint for AUX use."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                    <ComboBox ItemsSource="{Binding AudioDevices}"
                                              SelectedItem="{Binding SelectedAudioDevice}"
                                              DisplayMemberPath="Name" MinWidth="330"/>
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Content="Refresh" Command="{Binding RefreshDevicesCommand}"/>
                                        <Button Content="Start capture" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding StartAudioCommand}"/>
                                        <Button Content="Stop" Command="{Binding StopAudioCommand}"/>
                                    </WrapPanel>
                                    <TextBlock Text="Input gain" Margin="0,18,0,0"/>
                                    <Slider Value="{Binding InputGain}" Minimum="0" Maximum="4"
                                            TickFrequency="0.1" IsSnapToTickEnabled="False"/>
                                    <TextBlock Text="Noise gate (dBFS)" Margin="0,8,0,0"/>
                                    <Slider Value="{Binding NoiseGateDb}" Minimum="-100" Maximum="-20"
                                            TickFrequency="1"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Hue Bridge" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Discovery uses local mDNS plus Philips Hue’s discovery broker. Manual IP stays available."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                    <ComboBox ItemsSource="{Binding Bridges}"
                                              SelectedItem="{Binding SelectedBridge}"
                                              DisplayMemberPath="Name" MinWidth="330"/>
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Content="Discover" Command="{Binding DiscoverBridgesCommand}"/>
                                        <Button Content="Connect saved" Command="{Binding ConnectBridgeCommand}"/>
                                    </WrapPanel>
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding ManualBridgeAddress, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Bridge IP address or host name"/>
                                        <Button Grid.Column="1" Content="Add IP" Margin="8,0,0,0"
                                                Command="{Binding AddManualBridgeCommand}"/>
                                    </Grid>
                                    <Border Background="#1F1632" CornerRadius="8" Padding="12" Margin="0,15,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Pairing requires physical access" FontWeight="SemiBold"/>
                                            <TextBlock Text="Press the round link button on the bridge, then click Pair within 30 seconds."
                                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,9"/>
                                            <Button Content="Pair bridge" Style="{StaticResource PrimaryButton}"
                                                    HorizontalAlignment="Left" Command="{Binding PairBridgeCommand}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Live">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,16,2,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="260"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="Live spectrum" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="20 Hz" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <local:SpectrumVisualizer Grid.Row="1" Values="{Binding Spectrum}"/>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Bass / kick detector" Style="{StaticResource SectionTitle}"/>
                                    <local:BeatOrb Grid.Row="1" Activity="{Binding BassActivity}" Height="205"/>
                                    <StackPanel Grid.Row="2">
                                        <ProgressBar Value="{Binding BassActivity}" Maximum="100" Height="10"/>
                                        <TextBlock Text="{Binding LastBeat}" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                        <UniformGrid Columns="5">
                            <Border Style="{StaticResource Card}">
                                <StackPanel><TextBlock Text="SUB BASS" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="20–60 Hz" FontSize="16" Margin="0,4,0,12"/>
                                    <ProgressBar Value="{Binding SubBassLevel}" Maximum="100"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel><TextBlock Text="BASS / KICK" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="60–150 Hz" FontSize="16" Margin="0,4,0,12"/>
                                    <ProgressBar Value="{Binding BassActivity}" Maximum="100"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel><TextBlock Text="LOW MIDS" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="150–400 Hz" FontSize="16" Margin="0,4,0,12"/>
                                    <ProgressBar Value="{Binding LowMidsLevel}" Maximum="100"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel><TextBlock Text="MIDS" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="400–2k Hz" FontSize="16" Margin="0,4,0,12"/>
                                    <ProgressBar Value="{Binding MidsLevel}" Maximum="100"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel><TextBlock Text="HIGHS" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="2k–10k Hz" FontSize="16" Margin="0,4,0,12"/>
                                    <ProgressBar Value="{Binding HighsLevel}" Maximum="100"/></StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Lights">
                <Grid Margin="2,16,2,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Light selection and room position" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Select participating lights, assign physical positions, and arrange the custom chase order."
                                           Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Move up" Command="{Binding MoveLightUpCommand}"/>
                                <Button Content="Move down" Command="{Binding MoveLightDownCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                        <DataGrid ItemsSource="{Binding Lights}"
                                  SelectedItem="{Binding SelectedLight}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal"
                                  RowBackground="#11182A"
                                  AlternatingRowBackground="#141D32"
                                  Foreground="{StaticResource TextBrush}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="USE" Binding="{Binding IsSelected}" Width="65"/>
                                <DataGridTextColumn Header="LIGHT" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="MODEL" Binding="{Binding ModelId}" Width="130"/>
                                <DataGridTemplateColumn Header="POSITION" Width="175">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.LightPositions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      SelectedItem="{Binding Position, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="ORDER" Binding="{Binding Order, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                <DataGridCheckBoxColumn Header="REACHABLE" Binding="{Binding IsReachable}" IsReadOnly="True" Width="100"/>
                                <DataGridCheckBoxColumn Header="COLOR" Binding="{Binding SupportsColor}" IsReadOnly="True" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Effects">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,16,2,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Presets" Style="{StaticResource SectionTitle}"/>
                                <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0D1528" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                                                               TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Content="Apply preset" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ApplyPresetCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Effect and movement" Style="{StaticResource SectionTitle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Effect" Style="{StaticResource Caption}"/>
                                            <ComboBox ItemsSource="{Binding EffectModes}" SelectedItem="{Binding SelectedEffectMode}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="Chase direction" Style="{StaticResource Caption}"/>
                                            <ComboBox ItemsSource="{Binding ChaseDirections}" SelectedItem="{Binding SelectedChaseDirection}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Movement map" Style="{StaticResource Caption}"/>
                                            <ComboBox ItemsSource="{Binding MovementPatterns}" SelectedItem="{Binding SelectedMovementPattern}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,22,0">
                                        <TextBlock Text="Musical sensitivity" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="Bass / kick"/>
                                        <Slider Value="{Binding BassSensitivity}" Minimum="0.25" Maximum="2.5"/>
                                        <TextBlock Text="Mids"/>
                                        <Slider Value="{Binding MidSensitivity}" Minimum="0.25" Maximum="2.5"/>
                                        <TextBlock Text="Treble accents"/>
                                        <Slider Value="{Binding TrebleSensitivity}" Minimum="0.1" Maximum="2"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Motion envelope" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="Attack (ms)"/>
                                        <Slider Value="{Binding AttackMs}" Minimum="10" Maximum="400" TickFrequency="5"/>
                                        <TextBlock Text="Release (ms)"/>
                                        <Slider Value="{Binding ReleaseMs}" Minimum="80" Maximum="1500" TickFrequency="10"/>
                                        <TextBlock Text="Brightness limit"/>
                                        <Slider Value="{Binding BrightnessLimit}" Minimum="0.05" Maximum="1"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Color">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,16,2,12">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Musical palette editor" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Colors interpolate smoothly in palette order. Bass deepens the active color; treble only adds a restrained highlight."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                                <ListBox ItemsSource="{Binding PaletteSwatches}" SelectedItem="{Binding SelectedSwatch}"
                                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0B1220" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,12,12">
                                                <StackPanel>
                                                    <Border Width="150" Height="90" CornerRadius="8" Background="{Binding Brush}"/>
                                                    <TextBox Text="{Binding Hex, UpdateSourceTrigger=LostFocus}" Margin="0,9,0,0"
                                                             HorizontalContentAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel>
                                    <Button Content="Add color" Command="{Binding AddPaletteColorCommand}"/>
                                    <Button Content="Remove selected" Command="{Binding RemovePaletteColorCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Color limits" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Saturation limit"/>
                                    <Slider Value="{Binding SaturationLimit}" Minimum="0" Maximum="1"/>
                                    <CheckBox Content="Monochrome brightness-only mode" IsChecked="{Binding Monochrome}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Visual comfort" Style="{StaticResource SectionTitle}"/>
                                    <CheckBox Content="Strobe-safe smoothing" IsChecked="{Binding StrobeSafe}"/>
                                    <TextBlock Text="Maximum single-hit intensity" Margin="0,8,0,0"/>
                                    <Slider Value="{Binding MaximumFlashIntensity}" Minimum="0.1" Maximum="1"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Advanced">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,16,2,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Latency calibration" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Shift analysis timestamps to compensate for the audible path and perceived lamp response."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                    <TextBlock Margin="0,14,0,0">
                                        <Run Text="Offset: "/><Run Text="{Binding LatencyCompensationMs}"/><Run Text=" ms"/>
                                    </TextBlock>
                                    <Slider Value="{Binding LatencyCompensationMs}" Minimum="-250" Maximum="500" TickFrequency="5"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Hue output strategy" Style="{StaticResource SectionTitle}"/>
                                    <CheckBox Content="Prefer Entertainment streaming when available"
                                              IsChecked="{Binding UseEntertainment}"/>
                                    <TextBlock Text="Entertainment area" Margin="0,10,0,5"/>
                                    <ComboBox ItemsSource="{Binding EntertainmentConfigurations}"
                                              SelectedItem="{Binding SelectedEntertainmentConfiguration}"
                                              DisplayMemberPath="Name"/>
                                    <TextBlock Text="Compatibility updates/sec" Margin="0,13,0,0"/>
                                    <Slider Value="{Binding CompatibilityUpdateRate}" Minimum="1" Maximum="10" TickFrequency="1"/>
                                    <TextBlock Text="Entertainment frames/sec" Margin="0,8,0,0"/>
                                    <Slider Value="{Binding EntertainmentUpdateRate}" Minimum="25" Maximum="60" TickFrequency="1"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Live diagnostics" Style="{StaticResource SectionTitle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Current Hue rate" Style="{StaticResource Caption}"/>
                                            <TextBlock FontSize="28" FontWeight="Bold">
                                                <Run Text="{Binding HueUpdateRate}"/><Run Text=" Hz"/>
                                            </TextBlock>
                                            <TextBlock Text="Dropped audio chunks" Style="{StaticResource Caption}" Margin="0,16,0,0"/>
                                            <TextBlock Text="{Binding DroppedAudioChunks}" FontSize="24" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Failed Hue frames" Style="{StaticResource Caption}"/>
                                            <TextBlock Text="{Binding FailedHueFrames}" FontSize="28" FontWeight="Bold"/>
                                            <TextBlock Text="Bridge mode" Style="{StaticResource Caption}" Margin="0,16,0,0"/>
                                            <TextBlock Text="{Binding BridgeMode}" FontSize="15" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Compatibility behavior" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Bridge v2 / Pro: HTTPS local API plus Entertainment DTLS streaming when an area and client key are available."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <TextBlock Text="Bridge v1: local API v1 only, coalesced individual-light updates, lower cadence, longer transitions, no Entertainment streaming."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                    <Button Content="Save settings" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Logs">
                <Border Style="{StaticResource Card}" Margin="2,16,2,12" Padding="8">
                    <DataGrid ItemsSource="{Binding Logs}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              RowBackground="#11182A"
                              AlternatingRowBackground="#141D32"
                              Foreground="{StaticResource TextBrush}"
                              Background="Transparent"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TIME" Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Width="115"/>
                            <DataGridTextColumn Header="LEVEL" Binding="{Binding Level}" Width="90"/>
                            <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="180"/>
                            <DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#0D1425" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FB7185" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Stop show" Command="{Binding StopShowCommand}"/>
                    <Button Content="Start light show" Style="{StaticResource PrimaryButton}"
                            Command="{Binding StartShowCommand}" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
